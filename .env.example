# Copy this file to `.env` (already git-ignored) and fill in real values.
# `.env` is loaded automatically by `reqguard` on startup (load_dotenv, never
# overrides a variable already exported in your real shell). Not needed at
# all for --replay mode -- no key, no spend, no .env required.

# Currently in use for live runs (Track B is mid-migration to Gemini --
# see COLLAB.md session 6). Set whichever provider's key you're using.
GEMINI_API_KEY=

# Legacy / original provider. No longer required once the Gemini migration
# lands, but harmless to leave blank.
ANTHROPIC_API_KEY=
