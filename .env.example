# Copy this file to `.env` (already git-ignored) and fill in real values.
# `.env` is loaded automatically by `reqguard` on startup (load_dotenv, never
# overrides a variable already exported in your real shell). Not needed at
# all for --replay mode -- no key, no spend, no .env required.

# ── Recommended: OpenRouter ─────────────────────────────────────────────
# The easiest way to get a live key. Sign up at https://openrouter.ai,
# create a key at https://openrouter.ai/keys, add a small balance, and set
# it here. This alone is enough to run `reqguard analyze` on a real repo.
OPENROUTER_API_KEY=

# ── Optional: additional providers ──────────────────────────────────────
# ReqGuard tries every configured provider on each call (in the order below)
# before giving up -- set more than one for automatic failover if your
# primary is rate-limited or down. Each is independently optional; set only
# the ones you have a key for.

# aerolink (OpenAI-compatible relay -- multiple candidate models, see
# client.py's docstring). No public signup link is documented here yet.
AEROLINK_API_KEY=
AEROLINK_BASE_URL=https://cgapi.aerolink.lat/v1
AEROLINK_MODEL=gpt-5.6-terra

# Conduit (OpenAI-compatible endpoint).
CONDUIT_API_KEY=
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1
