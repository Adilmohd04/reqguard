# Copy this file to `.env` (already git-ignored) and fill in real values.
# `.env` is loaded automatically by `reqguard` on startup (load_dotenv, never
# overrides a variable already exported in your real shell). Not needed at
# all for --replay mode -- no key, no spend, no .env required.

# Provider history (see COLLAB.md): Anthropic -> Gemini -> OpenRouter -> Conduit.
# client.py._get_client() prefers CONDUIT_API_KEY + CONDUIT_BASE_URL; if unset,
# falls back to OPENROUTER_API_KEY against policy.py's BASE_URL (OpenRouter).
# Only set the pair you're actually using.
CONDUIT_API_KEY=
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1

OPENROUTER_API_KEY=
